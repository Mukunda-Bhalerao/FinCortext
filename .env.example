# Copy to .env (same folder) and fill in. Never commit .env.

# Upstox developer app (https://account.upstox.com/developer/apps).
# The redirect URL registered on the app must match UPSTOX_REDIRECT_URI exactly.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/upstox/callback

# Simplest option: an Analytics Token (read-only, valid one year) from the Upstox developer
# console. Paste the token here; leave UPSTOX_API_KEY / UPSTOX_API_SECRET empty if unused.
# A token obtained through "Connect Upstox" in the app takes precedence.
UPSTOX_ACCESS_TOKEN=

# Where the browser is redirected after sign-in, and the only origin allowed to call the API.
FRONTEND_URL=http://localhost:5173

# Live prices: "stream" (Upstox market data WebSocket, falls back to polling) or "poll".
LIVE_MODE=stream
POLL_INTERVAL_SECONDS=3

# Market headlines from public RSS feeds.
NEWS_ENABLED=true

# Relative paths resolve against backend/. In Docker this is set to /data/fincortext.duckdb.
DUCKDB_PATH=./data/fincortext.duckdb
LOG_LEVEL=INFO

# Optional language layer. It phrases research rationales, writes the portfolio brief and
# answers questions, using only facts the engine computed; output with numbers that are not in
# those facts is discarded. "none" keeps templated text and turns the assistant off.
# "ollama" uses an Ollama server: a local model (e.g. `ollama pull llama3.2`), or a cloud model
# routed by a signed-in local Ollama (e.g. OLLAMA_MODEL=gpt-oss:120b-cloud, free tier with
# usage limits). To call ollama.com directly instead, set OLLAMA_URL=https://ollama.com and
# OLLAMA_API_KEY. The key stays on the backend.
LLM_PROVIDER=none
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=
# Calls per IST day across the brief, the assistant and rationales; built-in text is used after.
LLM_DAILY_CALLS=150
# Rephrase every agent rationale with the model (four calls per research run).
LLM_RATIONALES=false

# --- deployment ------------------------------------------------------------------------------
# In a deployment the API also serves the built interface, so there is one origin and no CORS;
# FRONTEND_URL is then only used to build the Upstox redirect back into the app.
# The host sets PORT (Render, Railway, Fly); the container honours it.
# Set secrets in the host's dashboard, never in this file.
