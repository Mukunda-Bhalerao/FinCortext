# Copy to .env (same folder) and fill in. Never commit .env.

# Upstox developer app (https://account.upstox.com/developer/apps).
# The redirect URL registered on the app must match UPSTOX_REDIRECT_URI exactly.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/upstox/callback

# Simplest option: an Analytics Token (read-only, valid one year) from the Upstox developer
# console. Paste the token here; leave UPSTOX_API_KEY / UPSTOX_API_SECRET empty if unused.
# A token obtained through "Connect Upstox" in the app takes precedence.
UPSTOX_ACCESS_TOKEN=

# Where the browser is redirected after sign-in, and the only origin allowed to call the API.
FRONTEND_URL=http://localhost:5173

# Live prices: "stream" (Upstox market data WebSocket, falls back to polling) or "poll".
LIVE_MODE=stream
POLL_INTERVAL_SECONDS=3

# Market headlines from public RSS feeds.
NEWS_ENABLED=true

# Relative paths resolve against backend/.
DUCKDB_PATH=./data/fincortext.duckdb
LOG_LEVEL=INFO

# Optional language layer: phrases research rationales from the evidence only. "none" uses
# templated text. "ollama" needs a local Ollama server with a chat model pulled
# (e.g. `ollama pull llama3.2`); output with numbers not present in the evidence is discarded.
LLM_PROVIDER=none
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
