# =====================================================================
# FinCortext environment configuration (template)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =====================================================================

# --- News provider ---------------------------------------------------
# NewsAPI key (https://newsapi.org). Leave empty to run without live news;
# the Sentiment Analyst will then report news as UNAVAILABLE (or use
# explicitly selected sample data).
NEWS_API_KEY=

# --- Storage ---------------------------------------------------------
# Path to the local DuckDB analytical database file.
# Relative paths are resolved against the repository root.
FINCORTEXT_DB_PATH=data/processed/fincortext.duckdb

# --- Backend ---------------------------------------------------------
# FastAPI host/port and CORS origins (comma-separated) allowed to call it.
FINCORTEXT_HOST=127.0.0.1
FINCORTEXT_PORT=8000
FINCORTEXT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log level: DEBUG | INFO | WARNING | ERROR
FINCORTEXT_LOG_LEVEL=INFO

# --- Market data -----------------------------------------------------
# Default history window (calendar days) when refreshing market prices.
FINCORTEXT_MARKET_HISTORY_DAYS=730

# --- Sentiment model -------------------------------------------------
# Hugging Face model id used by the Sentiment Analyst.
FINCORTEXT_SENTIMENT_MODEL=ProsusAI/finbert

# Directory used to cache the downloaded sentiment model.
FINCORTEXT_SENTIMENT_CACHE_DIR=data/cache/sentiment-model